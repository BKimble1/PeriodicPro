# macOS
.DS_Store

# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive
*.xcresult

# Local, per-developer configuration (Team ID, personal bundle identifier).
# Never commit this file.
Config/Local.xcconfig

# Signing material — must only ever exist as GitHub secrets.
*.p12
*.p8
*.mobileprovision
*.cer
*.certSigningRequest
ExportOptions.plist

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.resolved

# Python tooling
__pycache__/
*.pyc
.venv/

# Fastlane, if it is ever added
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# Per-element detail previews are regenerated on demand by
# Tools/preview_detail.py; only the combined sheets are tracked.
Design/detail-[A-Z]*.png

# Node — only ever installed for website/scripts/check_site.js
node_modules/
package-lock.json
package.json

# Checker output
website/.preview/

# elemora-netlify.zip is NOT ignored: it is committed as a ready-to-upload
# deployment artifact. Rebuild it with website/scripts/make_zip.sh after any
# change under website/site/.

# Generated at deploy time from the template, with the Apple Team ID injected.
website/site/.well-known/apple-app-site-association
