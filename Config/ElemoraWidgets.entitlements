<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one capability the widget needs, and the only one it has.

	     The App Group is the shared container the widget writes its answer log
	     into and reads the app's published snapshot from. It is not a network
	     permission and not an account: nothing in this group leaves the
	     device. The identifier is derived from the app's bundle identifier and
	     must stay in step with ElemoraAppGroup.identifier in the shared source
	     — Tools/check_widget_shared.py compares the two. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.idlery.periodicpro</string>
	</array>
</dict>
</plist>
