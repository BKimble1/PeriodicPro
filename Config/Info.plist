<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Every other Info.plist key is generated from INFOPLIST_KEY_* build
	     settings (see the project's build configurations). This file holds only
	     keys Xcode does not generate.

	     The app's only network requests are plain HTTPS lookups to PubChem for
	     compound information, and it uses no encryption beyond what the
	     operating system provides, so it qualifies for the standard export
	     compliance exemption. Declaring it here means TestFlight never stops to
	     ask before distributing a build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- There is deliberately no document type and no exported UTI. A quiz used
	     to travel as a `.elemoraquiz` JSON file, which meant a generic white
	     document tile in Messages and a trip through the Files app to open one.
	     Quizzes are now shared as ordinary https links under
	     https://elemora.idlery.com/quiz/…, handled as Universal Links through
	     the associated-domains entitlement in Config/Elemora.entitlements —
	     so there is no file for anyone to see, pick or import. -->
</dict>
</plist>
