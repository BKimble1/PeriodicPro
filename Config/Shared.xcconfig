// ---------------------------------------------------------------------------
// Periodic Pro — central project configuration
//
// Everything a person renaming or re-signing this product needs to change is
// in this file. Nothing here is a secret; signing identities are supplied by
// CI or by Local.xcconfig, which is git-ignored.
// ---------------------------------------------------------------------------

// The name shown under the icon on the Home Screen.
APP_DISPLAY_NAME = Periodic Pro

// PLACEHOLDER — replace with a bundle identifier you own in App Store Connect
// before the first TestFlight upload. The two test bundles derive from it.
PRODUCT_BUNDLE_IDENTIFIER_BASE = com.example.periodicpro

// Semantic marketing version. Bump for every release you show to testers.
MARKETING_VERSION = 1.0.0

// Build number. CI overrides this on the command line with a monotonic value.
CURRENT_PROJECT_VERSION = 1

// PLACEHOLDER — your 10-character Apple Developer Team ID. Left empty on
// purpose so a build never silently signs with the wrong team. Supply it via
// Config/Local.xcconfig locally, or `DEVELOPMENT_TEAM=...` on the xcodebuild
// command line in CI.
APP_DEVELOPMENT_TEAM =

// --- Platform --------------------------------------------------------------
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO

// --- Swift -----------------------------------------------------------------
// Swift 5 language mode on the Swift 6 toolchain: all the modern syntax,
// without opting the whole project into strict concurrency in v1.
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
SWIFT_EMIT_LOC_STRINGS = YES

// --- Diagnostics -----------------------------------------------------------
GCC_WARN_UNDECLARED_SELECTOR = YES
CLANG_WARN_DOCUMENTATION_COMMENTS = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES

// Optional developer overrides (DEVELOPMENT_TEAM, a personal bundle id, ...).
// Create Config/Local.xcconfig from Config/Local.xcconfig.sample; it is
// git-ignored and must never contain anything secret beyond identifiers.
#include? "Local.xcconfig"
