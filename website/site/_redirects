# Netlify redirect rules for elemora.idlery.com
# Format: <from>  <to>  <status>
# Docs: https://docs.netlify.com/routing/redirects/
#
# Netlify already normalises trailing slashes and serves /support/ from
# support/index.html, so only genuine aliases belong here. Anything unmatched
# falls through to 404.html.

# A shared quiz is https://elemora.idlery.com/quiz/<encoded-payload>. The payload
# IS the quiz -- nothing about it is stored on this site -- so it has to survive
# untouched. This is a 200 rewrite, not a redirect: the address bar keeps the
# URL the sender actually sent, which is the URL Apple's Universal Link matching
# and the app both read. A 301 here would rewrite the quiz out of the link.
/quiz/*          /quiz/index.html    200

# Legacy .html paths, in case anything ever linked to them. There is no rule
# for /index.html: Netlify serves an existing file ahead of a redirect, so it
# could never fire, and Netlify normalises /index.html to / by itself.
/privacy.html    /privacy/   301
/terms.html      /terms/     301
/support.html    /support/   301

# Words people actually type
/help            /support/   301
/contact         /support/   301
/faq             /support/   301
/legal           /terms/     301
/privacy-policy  /privacy/   301
/terms-of-use    /terms/     301
/tos             /terms/     301
/eula            /terms/     301

# The legacy project name, so any old link lands on the product page
/periodicpro     /           301
/periodic-pro    /           301

# A short link for the download call to action. While Elemora is pre-release
# this points at the page section; scripts/apply_config.py rewrites it to the
# App Store URL once website/config.json has one.
# APPSTORE:REDIRECT:START
/download        /#get       302
/app             /#get       302
# APPSTORE:REDIRECT:END
